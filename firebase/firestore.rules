rules_version = '2';

// Pustaka Daring. Satu-satunya penjaga data: aplikasi berjalan di browser, jadi semua batasan harus ada di sini.
//
//   members/{email}            { role: 'member' | 'admin', addedBy, addedAt }
//   folders/{id}               { name, parent, custom, readers, editors, createdBy, createdByName, createdByEmail, createdAt }
//   sops/{id}                  isi terkini beserta metadata; `folder` berisi id folder (tidak ada/null = tingkat utama)
//   sops/{id}/versions/{rev}   isi yang tertimpa, tidak bisa diubah
//   editing/{sopId_uid}        keterangan "sedang diedit" (hanya info, bukan kunci)
//   stats/usage                { bytes, limit, lastSop }: hanya admin yang bisa membaca
//   stats/capacity             tanpa isi: boleh dibaca selama pustaka belum penuh
//
// Hak akses: `readers` (view atau edit) dan `editors` (edit) berisi email, atau '*' untuk semua anggota. Pemilik
// selalu tercantum. `custom` false berarti mengikuti folder induk: daftarnya harus sama persis dengan milik induk
// ditambah pemiliknya. Daftar disalin ke tiap dokumen karena kueri Firestore tidak bisa menelusuri rantai folder.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Identitas ----
    function email() {
      return request.auth.token.email.lower();
    }
    function uid() {
      return request.auth.uid;
    }
    // Staf yang belum punya email UB memakai Gmail. Akun Gmail siapa pun lolos di sini; yang menentukan adalah isMember().
    function inDomain() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email().matches('.*@(ub[.]ac[.]id|gmail[.]com)$');
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(email());
    }
    function isMember() {
      return inDomain() && exists(memberPath());
    }
    function isAdmin() {
      return isMember() && get(memberPath()).data.role == 'admin';
    }

    // ---- Penghitung ruang ----
    function usagePath() {
      return /databases/$(database)/documents/stats/usage;
    }
    function usageChangedBy(n) {
      return getAfter(usagePath()).data.bytes == get(usagePath()).data.bytes + n;
    }
    function withinLimit() {
      return getAfter(usagePath()).data.bytes <= get(usagePath()).data.limit;
    }

    // ---- SOP ----
    function sopPath(id) {
      return /databases/$(database)/documents/sops/$(id);
    }
    function isOwnerOrAdmin(sop) {
      return sop.createdBy == uid() || isAdmin();
    }
    function granted(list) {
      return email() in list || '*' in list;
    }
    function canRead(sop) {
      return isMember() && (
        isAdmin()
        || (sop.deletedBy == null && (sop.createdBy == uid() || granted(sop.readers)))
        || sop.deletedBy == uid()
      );
    }
    function canEdit(sop) {
      return isMember() && sop.deletedBy == null && (isOwnerOrAdmin(sop) || granted(sop.editors));
    }
    function jsonBytes(d) {
      return d.json.toUtf8().size();
    }
    function validContent(d) {
      return d.json is string
        && jsonBytes(d) <= 524288
        && d.size == jsonBytes(d)
        && !d.json.matches('(?s).*data:image/.*') // isi pustaka hanya teks, tanpa gambar
        && d.title is string && d.title.size() <= 300
        && d.nomor is string && d.nomor.size() <= 120
        && d.updatedAt == request.time
        && d.updatedBy == uid()
        && d.updatedByName is string && d.updatedByName.size() <= 120;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function validFolderRef(v) {
      return v == null || (v is string && v.size() <= 64 && v.matches('[^/]+'));
    }

    // ---- Hak akses ----
    function folderPath(id) {
      return /databases/$(database)/documents/folders/$(id);
    }
    function ownerSet(owner) {
      return (owner == null ? [] : [owner]).toSet();
    }
    function validAccess(d) {
      return d.custom is bool
        && d.readers is list && d.readers.size() <= 200
        && d.editors is list && d.editors.size() <= 200
        && d.readers.hasAll(d.editors);
    }
    // Daftar sama persis dengan milik folder induk ditambah pemiliknya. Tanpa induk (tingkat utama, atau foldernya
    // sudah terhapus), hanya pemiliknya. Karena isinya sudah ditentukan, siapa pun boleh menyalinnya.
    function mirrors(d, owner, folder) {
      return folder == null || !existsAfter(folderPath(folder))
        ? d.readers.toSet() == ownerSet(owner) && d.editors.toSet() == ownerSet(owner)
        : d.readers.toSet() == getAfter(folderPath(folder)).data.readers.toSet().union(ownerSet(owner))
          && d.editors.toSet() == getAfter(folderPath(folder)).data.editors.toSet().union(ownerSet(owner));
    }
    function accessOk(d, owner, folder) {
      return validAccess(d)
        && d.editors.toSet().hasAll(ownerSet(owner))
        && (d.custom == true || mirrors(d, owner, folder));
    }
    // Isi folder (SOP, subfolder, atau yang dipindahkan ke dalamnya) hanya boleh ditambah oleh yang punya hak edit.
    function canAddTo(folder) {
      return folder == null
        || isAdmin()
        || get(folderPath(folder)).data.createdBy == uid()
        || granted(get(folderPath(folder)).data.editors);
    }

    function isValidCreate(d) {
      return isMember()
        && d.keys().hasOnly(['title', 'nomor', 'json', 'size', 'totalBytes', 'rev', 'folder', 'custom', 'readers', 'editors', 'createdBy', 'createdByName', 'createdByEmail', 'createdAt', 'updatedAt', 'updatedBy', 'updatedByName', 'deletedAt', 'deletedBy'])
        && validContent(d)
        && validFolderRef(d.get('folder', null))
        && canAddTo(d.get('folder', null))
        && validAccess(d)
        && d.custom == false
        && mirrors(d, email(), d.get('folder', null))
        && d.rev == 1
        && d.totalBytes == d.size
        && d.createdBy == uid()
        && d.createdByName is string && d.createdByName.size() <= 120
        && d.createdByEmail == email()
        && d.createdAt == request.time
        && d.deletedAt == null
        && d.deletedBy == null
        && usageChangedBy(d.size)
        && withinLimit();
    }

    // Simpan isi: isi lama wajib berpindah ke riwayat dalam penulisan yang sama, dan `rev` yang
    // harus tepat +1 membuat simpanan dari salinan yang sudah usang ditolak server.
    function isContentSave(id, d, r) {
      return changed().hasOnly(['title', 'nomor', 'json', 'size', 'totalBytes', 'rev', 'updatedAt', 'updatedBy', 'updatedByName'])
        && canEdit(r)
        && validContent(d)
        && d.rev == r.rev + 1
        && d.totalBytes == r.totalBytes + d.size
        && (d.title == r.title || isOwnerOrAdmin(r))
        && existsAfter(/databases/$(database)/documents/sops/$(id)/versions/$(string(r.rev)))
        && usageChangedBy(d.size)
        && withinLimit();
    }
    // `visibility` hanya ada pada SOP dari sebelum hak akses per pengguna; perubahan ini sekaligus membuangnya.
    function isAccessChange(d, r) {
      return changed().hasOnly(['custom', 'readers', 'editors', 'visibility'])
        && !d.keys().hasAny(['visibility'])
        && (r.deletedBy == null || isAdmin())
        && isMember()
        && isOwnerOrAdmin(r)
        && accessOk(d, r.createdByEmail, r.get('folder', null));
    }
    function isAccessSync(d, r) {
      return changed().hasOnly(['readers', 'editors'])
        && r.custom == false
        && r.deletedBy == null
        && isMember()
        && validAccess(d)
        && mirrors(d, r.createdByEmail, r.get('folder', null));
    }
    function isFolderMove(d, r) {
      return changed().hasOnly(['folder', 'readers', 'editors'])
        && validFolderRef(d.folder)
        && r.deletedBy == null
        && isMember()
        && isOwnerOrAdmin(r)
        && canAddTo(d.folder)
        && validAccess(d)
        && (r.custom == true ? (d.readers == r.readers && d.editors == r.editors) : mirrors(d, r.createdByEmail, d.folder));
    }
    function isMoveToBin(d, r) {
      return changed().hasOnly(['deletedAt', 'deletedBy'])
        && r.deletedBy == null
        && d.deletedBy == uid()
        && d.deletedAt == request.time
        && isMember()
        && isOwnerOrAdmin(r);
    }
    function isRestore(d, r) {
      return changed().hasOnly(['deletedAt', 'deletedBy'])
        && r.deletedBy != null
        && d.deletedBy == null
        && d.deletedAt == null
        && isMember()
        && (r.deletedBy == uid() || isAdmin());
    }

    match /sops/{id} {
      allow read: if canRead(resource.data);
      allow create: if isValidCreate(request.resource.data);
      allow update: if isContentSave(id, request.resource.data, resource.data)
        || isAccessChange(request.resource.data, resource.data)
        || isAccessSync(request.resource.data, resource.data)
        || isFolderMove(request.resource.data, resource.data)
        || isMoveToBin(request.resource.data, resource.data)
        || isRestore(request.resource.data, resource.data);
      allow delete: if isMember()
        && resource.data.deletedBy != null
        && (resource.data.deletedBy == uid() || isAdmin())
        && usageChangedBy(-resource.data.totalBytes);

      match /versions/{rev} {
        function parent() {
          return get(sopPath(id)).data;
        }
        allow read: if canRead(parent());
        // Riwayat hanya bisa berisi salinan persis dari isi yang sedang ditimpa.
        allow create: if canEdit(parent())
          && rev == string(parent().rev)
          && getAfter(sopPath(id)).data.rev == parent().rev + 1
          && request.resource.data.keys().hasOnly(['rev', 'title', 'nomor', 'json', 'size', 'savedAt', 'savedBy', 'savedByName'])
          && request.resource.data.rev == parent().rev
          && request.resource.data.title == parent().title
          && request.resource.data.nomor == parent().nomor
          && request.resource.data.json == parent().json
          && request.resource.data.size == parent().size
          && request.resource.data.savedAt == parent().updatedAt
          && request.resource.data.savedBy == parent().updatedBy
          && request.resource.data.savedByName == parent().updatedByName;
        // Riwayat hanya terhapus bersama SOP-nya.
        allow delete: if isMember()
          && parent().deletedBy != null
          && (parent().deletedBy == uid() || isAdmin())
          && !existsAfter(sopPath(id));
      }
    }

    // ---- Folder ----
    // Di tingkat utama semua anggota bisa membuat folder; di dalam folder perlu hak edit atas folder itu.
    // Ubah nama, pindah, hak akses, dan hapus: pemilik dan admin.
    function validFolder(d) {
      return d.name is string
        && d.name.size() > 0 && d.name.size() <= 120
        && d.name == d.name.trim()
        && validFolderRef(d.parent);
    }
    match /folders/{id} {
      allow read: if isMember() && (isOwnerOrAdmin(resource.data) || granted(resource.data.readers));
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'parent', 'custom', 'readers', 'editors', 'createdBy', 'createdByName', 'createdByEmail', 'createdAt'])
        && validFolder(request.resource.data)
        && canAddTo(request.resource.data.parent)
        && validAccess(request.resource.data)
        && request.resource.data.custom == false
        && mirrors(request.resource.data, email(), request.resource.data.parent)
        && request.resource.data.createdBy == uid()
        && request.resource.data.createdByEmail == email()
        && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 120
        && request.resource.data.createdAt == request.time;
      allow update: if isMember() && (
        // Ubah nama
        (isOwnerOrAdmin(resource.data) && changed().hasOnly(['name']) && validFolder(request.resource.data))
        // Pindah; folder yang mengikuti induk langsung memakai daftar induk barunya
        || (isOwnerOrAdmin(resource.data)
          && changed().hasOnly(['parent', 'readers', 'editors'])
          && validFolder(request.resource.data)
          && request.resource.data.parent != id
          && canAddTo(request.resource.data.parent)
          && validAccess(request.resource.data)
          && (resource.data.custom == true
            ? (request.resource.data.readers == resource.data.readers && request.resource.data.editors == resource.data.editors)
            : mirrors(request.resource.data, resource.data.get('createdByEmail', null), request.resource.data.parent)))
        // Hak akses
        || (isOwnerOrAdmin(resource.data)
          && changed().hasOnly(['custom', 'readers', 'editors'])
          && accessOk(request.resource.data, resource.data.get('createdByEmail', null), resource.data.parent))
        // Menyalin daftar dari induk
        || (changed().hasOnly(['readers', 'editors'])
          && resource.data.custom == false
          && validAccess(request.resource.data)
          && mirrors(request.resource.data, resource.data.get('createdByEmail', null), resource.data.parent))
        // Folder dari sebelum hak akses per pengguna belum mencatat email pemiliknya
        || (changed().hasOnly(['createdByEmail'])
          && !resource.data.keys().hasAny(['createdByEmail'])
          && resource.data.createdBy == uid()
          && request.resource.data.createdByEmail == email())
      );
      allow delete: if isMember() && isOwnerOrAdmin(resource.data);
    }

    // ---- "Sedang diedit" ----
    match /editing/{key} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['sopId', 'uid', 'name', 'at'])
        && request.resource.data.uid == uid()
        && key == request.resource.data.sopId + '_' + uid()
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && canEdit(get(sopPath(request.resource.data.sopId)).data);
      // Keterangan yang sudah kedaluwarsa boleh dibersihkan siapa saja (browser pemiliknya mungkin sudah tertutup).
      allow delete: if isMember() && (resource.data.uid == uid() || isAdmin() || resource.data.at < request.time - duration.value(5, 'm'));
    }

    // ---- Ruang penyimpanan ----
    match /stats/usage {
      allow get: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['bytes', 'limit', 'lastSop'])
        && request.resource.data.bytes is int
        && request.resource.data.limit is int;
      // Anggota memperbarui penghitung tanpa bisa membacanya, dan hanya bersama penulisan SOP
      // yang aturannya memeriksa selisih ukurannya. Berdiri sendiri, penulisan ini ditolak.
      allow update: if isMember()
        && changed().hasOnly(['bytes', 'lastSop'])
        && (
          existsAfter(sopPath(request.resource.data.lastSop))
            ? getAfter(sopPath(request.resource.data.lastSop)).data.updatedAt == request.time
            : exists(sopPath(request.resource.data.lastSop))
        );
    }
    match /stats/capacity {
      allow get: if isMember() && get(usagePath()).data.bytes < get(usagePath()).data.limit;
    }

    // ---- Anggota ----
    match /members/{member} {
      // Semua anggota bisa melihat daftar ini untuk memilih kepada siapa file dibagikan.
      allow get: if inDomain() && (member == email() || isMember());
      allow list: if isMember();
      allow create: if isAdmin() && validMember(member);
      allow update: if isAdmin() && member != email() && validMember(member);
      // Admin tidak bisa mencabut aksesnya sendiri, agar pustaka tidak kehilangan admin terakhir.
      allow delete: if isAdmin() && member != email();

      function validMember(member) {
        return member.matches('^[^@/]+@(ub[.]ac[.]id|gmail[.]com)$')
          && member == member.lower()
          && request.resource.data.keys().hasOnly(['role', 'addedBy', 'addedAt'])
          && request.resource.data.role in ['member', 'admin']
          && request.resource.data.addedBy == email()
          && request.resource.data.addedAt == request.time;
      }
    }
  }
}
